{
  "name": "omniforge-3d-engine",
  "version": "0.10.0",
  "private": true,
  "description": "General-purpose AI-native 3D game engine with connected asset, foliage, lighting, atmosphere, and world systems.",
  "type": "module",
  "scripts": {
    "start": "node server/v010-bootstrap.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "node scripts/verify.mjs",
    "mcp": "node bridge/mcp-server.mjs",
    "reset": "node scripts/reset-state.mjs",
    "desktop": "electron desktop/main.cjs",
    "desktop:build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./BUILD_DESKTOP_WINDOWS.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "desktop/main.cjs",
  "productName": "OmniForge"
}
